MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=codecoachai_v1
MYSQL_USERNAME=root
# Local-only example credentials. Replace every value for shared or release environments.
MYSQL_PASSWORD=codecoachai-local-mysql
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=codecoachai-local-redis
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=codecoachai-local-elastic
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
CODECOACHAI_VECTOR_ENABLED=true
QDRANT_BASE_URL=http://qdrant:6333
QDRANT_API_KEY=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_AK=
OSS_SK=
OSS_BUCKET=
OSS_DOMAIN=
OSS_KEY_PREFIX=dev
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_STS_REGION_ID=cn-hangzhou
OSS_STS_ROLE_ARN=
# Compose-local default. For a shared test environment, replace it with the
# single address reachable from every application and initializer container.
NACOS_SERVER_ADDR=nacos:8848
NACOS_CONFIG_SCHEME=http
NACOS_CONFIG_CONTEXT_PATH=/nacos
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_ACCESS_TOKEN=
NACOS_AUTH_ENABLE=false
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_TOKEN=
# Required: use one existing, dedicated namespace ID for Config and Discovery.
# Do not use an empty value or the reserved/literal "public" namespace.
NACOS_NAMESPACE=
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
# The checked-in Nacos contract currently contains the reviewed six-file dev set only.
# Non-dev releases stay blocked until all six matching Data IDs and the runbook are updated.
SPRING_PROFILES_ACTIVE=dev
# When true, the local Compose Nacos initializer publishes only missing
# docs/nacos/codecoachai-*-dev.yml data IDs. Set false in a shared test
# environment after its reviewed Nacos configuration is already present.
NACOS_CONFIG_BOOTSTRAP_ENABLED=true

# Deployment-managed per-service internal signing keys. Values must be unique.
# Do not use CODECOACHAI_INTERNAL_<SERVICE>_SECRET names: Spring relaxed
# binding can map CODECOACHAI_INTERNAL_AUTH_SECRET onto the auth secret property.
CODECOACHAI_GATEWAY_TO_CORE_SIGNING_SECRET=
CODECOACHAI_GATEWAY_TO_AI_SIGNING_SECRET=
CODECOACHAI_GATEWAY_TO_SEARCH_SIGNING_SECRET=
CODECOACHAI_CALLER_CORE_SIGNING_SECRET=
CODECOACHAI_CALLER_AI_SIGNING_SECRET=
CODECOACHAI_CALLER_SEARCH_SIGNING_SECRET=
CODECOACHAI_AI_CRYPTO_SECRET_KEY=
CODECOACHAI_TASK_CONSUMERS_ENABLED=false
