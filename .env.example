MYSQL_PASSWORD=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
CODECOACHAI_VECTOR_ENABLED=true
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
OSS_AK=
OSS_SK=
OSS_BUCKET=
OSS_STS_ROLE_ARN=
NACOS_SERVER_ADDR=127.0.0.1:8848
# Keep the default namespace empty. The Java client maps it internally to "public";
# release tooling must use the Nacos Java client when updating this namespace.
SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=
NACOS_NAMESPACE=
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# Deployment-managed per-service internal signing keys. Values must be unique.
# Do not use CODECOACHAI_INTERNAL_<SERVICE>_SECRET names: Spring relaxed
# binding can map CODECOACHAI_INTERNAL_AUTH_SECRET onto the auth secret property.
CODECOACHAI_CALLER_GATEWAY_SIGNING_SECRET=
CODECOACHAI_CALLER_AUTH_SIGNING_SECRET=
CODECOACHAI_CALLER_USER_SIGNING_SECRET=
CODECOACHAI_CALLER_QUESTION_SIGNING_SECRET=
CODECOACHAI_CALLER_RESUME_SIGNING_SECRET=
CODECOACHAI_CALLER_FILE_SIGNING_SECRET=
CODECOACHAI_CALLER_INTERVIEW_SIGNING_SECRET=
CODECOACHAI_CALLER_AI_SIGNING_SECRET=
CODECOACHAI_CALLER_SYSTEM_SIGNING_SECRET=
CODECOACHAI_CALLER_TASK_SIGNING_SECRET=
CODECOACHAI_CALLER_SEARCH_SIGNING_SECRET=
