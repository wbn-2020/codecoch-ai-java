# Non-secret target settings
CODECOACHAI_DEPLOY_HOST=
CODECOACHAI_DEPLOY_PORT=22
CODECOACHAI_DEPLOY_USER=
CODECOACHAI_REMOTE_ROOT=/opt/codecoachai

# Both values must be established out of band before any connection.
CODECOACHAI_KNOWN_HOSTS=
CODECOACHAI_DEPLOY_HOST_FINGERPRINT=SHA256:

# Choose exactly one authentication method. Secret values must be injected
# into the current process environment by a secret manager or operator.
CODECOACHAI_DEPLOY_PASSWORD=
# CODECOACHAI_DEPLOY_IDENTITY_FILE=
# CODECOACHAI_DEPLOY_KEY_PASSPHRASE=

# Optional comma-separated operations health targets.
# CODECOACHAI_HEALTH_SERVICES=search=http://127.0.0.1:8091/actuator/health
# CODECOACHAI_HEALTH_CONTAINERS=search=codecoachai-search
