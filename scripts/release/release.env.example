# Non-secret target settings
CODECOACHAI_DEPLOY_HOST=
CODECOACHAI_DEPLOY_PORT=22
CODECOACHAI_DEPLOY_USER=
# Single source of truth for SFTP upload, current pointer, and Compose JAR mounts.
CODECOACHAI_REMOTE_ROOT=/opt/codecoachai

# Release Compose connects only to reviewed infrastructure endpoints. Use
# addresses reachable from the application containers, never host loopback.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=codecoachai_v1
MYSQL_USERNAME=
REDIS_HOST=
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=
ELASTICSEARCH_URIS=
ELASTICSEARCH_USERNAME=elastic
QDRANT_BASE_URL=
NACOS_SERVER_ADDR=
NACOS_CONFIG_SCHEME=http
NACOS_CONFIG_CONTEXT_PATH=/nacos
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=
# Optional initializer-only token. Java Nacos clients use the required username/password pair.
NACOS_ACCESS_TOKEN=
NACOS_CONFIG_BOOTSTRAP_ENABLED=false
SPRING_PROFILES_ACTIVE=dev
# Must equal the immutable release ID whose runtime image tar was loaded.
CODECOACHAI_RUNTIME_IMAGE_TAG=
# Pre-provision both images on the target host and pin each value by digest,
# for example registry.example/release-tool@sha256:<64 lowercase hex chars>.
CODECOACHAI_NACOS_GUARD_IMAGE=
CODECOACHAI_FLYWAY_TOOL_IMAGE=
# Keep the Compose project identity stable across candidate and rollback control bundles.
COMPOSE_PROJECT_NAME=codecoachai

# Both values must be established out of band before any connection.
CODECOACHAI_KNOWN_HOSTS=
CODECOACHAI_DEPLOY_HOST_FINGERPRINT=SHA256:

# Choose exactly one authentication method. Secret values must be injected
# into the current process environment by a secret manager or operator.
CODECOACHAI_DEPLOY_PASSWORD=
# CODECOACHAI_DEPLOY_IDENTITY_FILE=
# CODECOACHAI_DEPLOY_KEY_PASSPHRASE=

# Optional comma-separated operations health targets.
# CODECOACHAI_HEALTH_SERVICES=gateway=http://127.0.0.1:8080/actuator/health,core=http://127.0.0.1:9200/actuator/health,ai=http://127.0.0.1:9206/actuator/health,search=http://127.0.0.1:8091/actuator/health
# CODECOACHAI_HEALTH_CONTAINERS=gateway=codecoachai-gateway,core=codecoachai-core,ai=codecoachai-ai,search=codecoachai-search

# Runtime secrets required by docker-compose.release.yml. Keep them outside the
# file and inject them through the deployment secret manager.
# MYSQL_PASSWORD=
# REDIS_PASSWORD=
# ELASTIC_PASSWORD=
# QDRANT_API_KEY=
# OSS_BUCKET=
# OSS_AK=
# OSS_SK=
# DEEPSEEK_API_KEY=
# CODECOACHAI_AI_CRYPTO_SECRET_KEY=

# Internal-call HMAC signing secrets must be injected by the deployment secret
# manager. Use three directional Gateway receiver keys plus one unique outbound
# key for each non-Gateway sender. Never use the deprecated
# CODECOACHAI_INTERNAL_SECRET shared key in the four-service topology.
# CODECOACHAI_GATEWAY_TO_CORE_SIGNING_SECRET=
# CODECOACHAI_GATEWAY_TO_AI_SIGNING_SECRET=
# CODECOACHAI_GATEWAY_TO_SEARCH_SIGNING_SECRET=
# CODECOACHAI_CALLER_CORE_SIGNING_SECRET=
# CODECOACHAI_CALLER_AI_SIGNING_SECRET=
# CODECOACHAI_CALLER_SEARCH_SIGNING_SECRET=
